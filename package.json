{
  "name": "m3expressive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter workbench dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:visual": "playwright test",
    "gen:motion": "node scripts/gen-motion.ts",
    "figma:pull": "node scripts/figma-pull.ts",
    "gen:tokens": "node scripts/gen-tokens.ts",
    "figma:crop": "node scripts/figma-crop.ts",
    "gen:shapes": "node scripts/gen-shapes.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
