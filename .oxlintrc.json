{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-shadow": "off",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/immutability": "warn",
    "react/purity": "warn",
    // A stylesheet import exists for its side effect (the workbench entry loads global.css, which the
    // StyleX Vite plugin appends to); any other unassigned import still warns.
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Checkbox", "Switch", "Radio", "Slider", "TextField"]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "packages/m3/src/tokens/*.stylex.ts",
    "packages/m3/src/tokens/*-themes.ts",
    "packages/m3/src/tokens/typescale.ts",
    "packages/m3/src/shapes/figmaPaths.ts",
    "test-results/**",
    "playwright-report/**",
    ".scratch/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": ["typescript", "vitest"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expect.*", "assert*"]
          }
        ],
        "react/globals": "off",
        "vitest/valid-title": "off",
        "vitest/valid-expect": [
          "error",
          {
            "maxArgs": 2
          }
        ]
      }
    },
    {
      "files": ["**/shapes/graphics/**"],
      "plugins": ["typescript", "vitest"],
      "rules": {
        "vitest/expect-expect": "off",
        "vitest/no-conditional-expect": "off",
        "typescript/no-extraneous-class": "off"
      }
    }
  ]
}
